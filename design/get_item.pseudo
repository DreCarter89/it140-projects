# Project One Get-Item Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: get-item and inventory design for M7 Project Two
#
# Review the course-provided get-item flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, SET, ADD, or similar terms.

START get_item

    SET current_room = player's current location
    SET room_item = item located in current_room
    SET inventory = player's collected items

    DISPLAY "Enter the item you want to collect:"
    INPUT get_item_command

    IF get_item_command = room_item AND room_item is not empty THEN
       
        ADD room_item TO inventory
        REMOVE room_item FROM current_room   

        DISPLAY "You collected" + room_item

    ELSE  
         DISPLAY "Invalid item. That item is not available in this room."
         KEEP inventory uchnaged
    
    END IF

    DISPLAY "Current room:" + current_room
    DISPLAY "Inventory:" + inventory

    RETURN TO main gameplay loop

END get_item




