# Project One Move-Between-Rooms Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: conceptual support for M6; movement design for M7
#
# Review the course-provided movement flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, WHILE, SET, or similar terms.

SET current_room = "Command Center"
SET game_is_running = TRUE

WHILE game_is_running
    DISPLAY "Current room:" + current_room
    DISPLAY "Which direction would you like to move? (north, south, east, west)"
    INPUT movement_command

 IF movement_command is a valid exit from current_room THEN
    SET current_room = room connected to current_room in movement_command direction
    DISPLAY "You have entered" + current_room 
 ELSE
    DISPLAY "Invalid movement. You can;t move in that direction."
    KEEP current_room unchanged
 END IF

 CHECK whether the game has ended
 IF the game has ended THEN
    SET game_is_running = FALSE
 END IF
END WHILE


